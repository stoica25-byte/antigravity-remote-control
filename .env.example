# ==============================================================================
# Antigravity Remote Control Center - Environment Configuration
# ==============================================================================
# Copy this file as .env and customize the values:
#   cp .env.example .env
#
# Copia este archivo como .env y personaliza los valores.
# ==============================================================================

# --- Authentication / Autenticación ---
# Secret key for JWT token signing (use: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=CHANGE-ME-generate-a-secure-random-key
# Default admin password (change on first login)
ADMIN_PASSWORD=admin

# --- Server / Servidor ---
HOST=0.0.0.0
PORT=8080

# --- Second Brain Connection ---
# URL of your local Second Brain API instance
SECONDBRAIN_URL=http://127.0.0.1:8000
# Ingest token for note capture (leave empty if not required)
INGEST_TOKEN=

# --- Tunnel Configuration / Configuración de Túnel ---
# Methods: cloudflare_quick (random URL), cloudflare_token (managed), ngrok (static domain)
TUNNEL_METHOD=cloudflare_quick

# Cloudflare managed tunnel token (from Zero Trust dashboard)
CLOUDFLARE_TOKEN=

# Ngrok static domain (e.g., my-control.ngrok-free.app)
NGROK_DOMAIN=

# Persistent public URL for mobile bookmarks (for cloudflare_token or ngrok)
PERSISTENT_URL=

# --- Antigravity IDE Integration ---
# Path to the Antigravity brain directory (default: ~/.gemini/antigravity/brain)
# ANTIGRAVITY_BRAIN_PATH=C:\Users\YourName\.gemini\antigravity\brain

# CSRF token for Antigravity IDE proxy (auto-generated if not set)
# ANTIGRAVITY_CSRF_TOKEN=
